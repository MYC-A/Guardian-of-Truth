    "unrelated_value_suppresses_derivation": {
      "input": {
        "prompt": "⟦SYSTEM⟧\nReport subtotal plus tax.\n⟦ASSISTANT · ход 1⟧\n← TOOL_RESPONSE invoice: {\"invoice_id\":\"A\",\"subtotal\":10,\"tax\":10}\n← TOOL_RESPONSE profile: {\"customer_id\":\"B\",\"age\":30}",
        "response": "⟦ASSISTANT · ход 2⟧\nTotal is 30 EUR."
      },
      "binding": {
        "operation": "ARITHMETIC",
        "expression": "a+b",
