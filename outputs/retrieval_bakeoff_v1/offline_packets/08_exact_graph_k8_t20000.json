        "category": "HISTORY",
        "sha256": "74261297783c9c568885380f2f257277a01ff1d1b0017b687b06b20009d9bd78",
        "evidence_status": "ORIGINAL_SOURCE_NOT_CURRENT_TRUTH_OR_PERMISSION",
        "parent_source_length": 63,
