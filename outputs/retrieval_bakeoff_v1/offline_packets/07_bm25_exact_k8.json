      {
        "source_id": "q58",
        "document": "prompt",
        "start": 23417,
        "end": 27395,
        "text": "### Messaging App Lacks Necessary Permissions\nThe messaging app needs specific permissions to handle media and send messages.\nIf `check_app_permissions(app_name=\"messaging\")` shows \"storage\" and \"sms\" permissions are not listed as granted, guide the user to use `grant_app_permission(app_name=\"messaging\", permission=\"storage\")` and `grant_app_permission(app_name=\"messaging\", permission=\"sms\")` to grant the necessary permissions.\n</tech_support_policy>\n</policy>\n\n[AVAILABLE TOOLS]\n- get_customer_by_phone — Finds a customer by their primary contact or line phone number.\n    phone_number: string! — The phone number to search for.\n- get_customer_by_id — Retrieves a customer directly by their unique ID.\n    customer_id: string! — The unique identifier of the customer.\n- get_customer_by_name — Searches for customers by name and DOB. May return multiple matches if names are similar,\n    \n    DOB helps disambiguate.\n    full_name: string! — The full name of the customer.\n    dob: string! — Date of birth for verification, in the format YYYY-MM-DD.\n- get_details_by_id — Retrieves the details for a given ID.\n    \n    The ID must be a valid ID for a Customer, Line, Device, Bill, or Plan.\n    id: string! — The ID of the object to retrieve.\n- suspend_line — Suspends a specific line (max 6 months).\n    \n    Checks: Line status must be Active.\n    Logic: Sets line status to Suspended, records suspension_start_date.\n    customer_id: string! — ID of the customer who owns the line.\n    line_id: string! — ID of the line to suspend.\n    reason: string! — Reason for suspension.\n- resume_line — Resumes a suspended line.\n    \n    Checks: Line status must be Suspended or Pending Activation.\n    Logic: Sets line status to Active, clears suspension_start_date.\n    customer_id: string! — ID of the customer who owns the line.\n    line_id: string! — ID of the line to resume.\n- get_bills_for_customer — Retrieves a list of the customer's bills, most recent first.\n    customer_id: string! — ID of the customer.\n    limit: integer — Maximum number of bills to return.\n- send_payment_request — Sends a payment request to the customer for a specific bill.\n    \n    Checks:\n        - Customer exists\n        - Bill exists and belongs to the customer\n        - No other bills are already awaiting payment for this customer\n    Logic: Sets bill status to AWAITING_PAYMENT and notifies customer.\n    Warning: This method does not check if the bill is already PAID.\n    Always check the bill status before calling this method.\n    customer_id: string! — ID of the customer who owns the bill.\n    bill_id: string! — ID of the bill to send payment request for.\n- get_data_usage — Retrieves current billing cycle data usage for a line, including data\n    \n    refueling amount, data limit, and cycle end date.\n    customer_id: string! — ID of the customer who owns the line.\n    line_id: string! — ID of the line to check usage for.\n- enable_roaming — Enables international roaming on a line.\n    customer_id: string! — ID of the customer who owns the line.\n    line_id: string! — ID of the line to enable roaming for.\n- disable_roaming — Disables international roaming on a line.\n    customer_id: string! — ID of the customer who owns the line.\n    line_id: string! — ID of the line to disable roaming for.\n- transfer_to_human_agents — Transfer the user to a human agent, with a summary of the user's issue.\n    \n    Only transfer if\n     -  the user explicitly asks for a human agent\n     -  given the policy and the available tools, you cannot solve the user's issue.\n    summary: string! — A summary of the user's issue.\n- refuel_data — Refuels data for a specific line, adding to the customer's bill.\n    \n    Checks: Line status must be Active, Customer owns the line.\n    Logic: Adds data to the line and charges customer based on the plan's refueling rate.\n    customer_id: string! — ID of the customer who owns the line.\n    line_id: string! — ID of the line to refuel data for.\n",
        "parent_source_id": "h0",
