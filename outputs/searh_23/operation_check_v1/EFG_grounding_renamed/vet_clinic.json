 "case_id": "vet_clinic",
 "renderings_without_names": {
  "tool_h72": "Creates an admission record for an animal in the clinic system and assigns it a kennel. Input parameters: animal_id: string. Output: admission_id: string.",
  "tool_k25": "Compares the vaccination certificate on file against the required immunisation schedule and returns whether it is satisfied. Does not modify records. Input parameters: animal_id: string. Output: satisfied: boolean.",
  "tool_c19": "Books and performs the grooming service for an admitted animal. Input parameters: animal_id: string. Output: groomed: boolean.",
  "tool_p61": "Assigns the animal to an overnight boarding slot and starts the stay. Input parameters: animal_id: string. Output: stay_id: string.",
  "tool_l97": "Reads the owner's registered contact details from the patient file. Input parameters: animal_id: string. Output: phone: string, email: string.",
  "tool_d49": "Releases the animal back to the owner and closes the admission record. Input parameters: animal_id: string. Output: closed: boolean.",
  "tool_c33": "Reads the kennel occupancy log for the clinic. Input parameters: none. Output: entries: array."
