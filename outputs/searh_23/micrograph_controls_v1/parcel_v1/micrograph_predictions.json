          "actions": []
        },
        {
          "id": "p0",
          "type": "policy",
          "kind": "PRECONDITION",
          "quote": "Before dispatching any parcel, check that the address is valid for the SAME shipment. A check for a different shipment does not satisfy this condition."
        },
        {
          "id": "p1",
          "type": "policy",
          "kind": "LATEST",
          "quote": "Use the latest address-check result for that shipment. An earlier valid result cannot override a later invalid result."
        },
        {
          "id": "p2",
          "type": "policy",
          "kind": "AFTER_SUCCESS",
          "quote": "After a parcel has been dispatched successfully, record a shipping audit for the SAME shipment. Do not record the audit before successful dispatch."
        }
      ],
      "edges": [],
      "checks": []
    }
