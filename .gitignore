__pycache__/
*.pyc
*.egg-info/
.venv/
build/
dist/
outputs/*
!outputs/next/
outputs/next/*
!outputs/next/*.json
!outputs/cycle2/
outputs/cycle2/*
!outputs/cycle2/*.json
!outputs/vnext/
outputs/vnext/*
!outputs/vnext/*.json
!outputs/vnext/*.jsonl
model/
.env
.env.*
# Temporary user credential location; never stage this file while it holds a key.
.env.example
!.env.template
!outputs/vnext/real_valid/
outputs/vnext/real_valid/*
!outputs/vnext/real_valid/*.json
!outputs/vnext/real_valid/*.jsonl
!outputs/vnext/real_valid/*.csv

# session B (independent replication) artifacts under real_valid_b/
!outputs/vnext/real_valid_b/
!outputs/vnext/real_valid_b/**
# session B LLM caches stay local (replayable environment artifacts)
outputs/vnext/real_valid_b/**/*_llm_cache_*.json
outputs/vnext/real_valid_b/**/latency_probe_*

# session C FN-audit artifacts under fn_audit/
!outputs/vnext/fn_audit/
!outputs/vnext/fn_audit/**
# audit run working caches and the micro-test live cache stay local;
# the frozen frontend cache IS committed (byte-anchor of the audit replay)
outputs/vnext/fn_audit/run_a/llm_cache.json
outputs/vnext/fn_audit/run_b/llm_cache.json
outputs/vnext/fn_audit/micro_tests/diagnostic_llm_cache.json
